# JobEzz — Supabase Environment
# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase (Project Settings → API)

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...your-anon-key...

# بوابة الدفع (manual | mizapay | tadawul | stripe) — manual الآن
EXPO_PUBLIC_PAYMENT_GATEWAY=manual

# رقم حساب التحويل البنكي (للدفع اليدوي في المرحلة الأولى)
EXPO_PUBLIC_BANK_TRANSFER_INFO=واعد البنك التجاري الليبي - رقم الحساب: 000123456789
